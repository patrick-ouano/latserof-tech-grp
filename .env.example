# Copy to .env.local for local development, and set the same values in
# Vercel > Project > Settings > Environment Variables before launch.
#
# Without these the quote form still validates and submits, but the API
# route refuses to pretend it delivered anything:
#   - in development it logs the submission to the server console
#   - in production it returns 503 and the form tells the visitor to phone
# That is deliberate. Silently accepting a form and dropping the lead is the
# worst possible failure for a lead-generation site.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where Thomas wants quote requests to land.
QUOTE_TO_EMAIL=

# Must be an address on a domain verified in Resend.
# Defaults to quotes@latseroftech.com if unset.
QUOTE_FROM_EMAIL=
